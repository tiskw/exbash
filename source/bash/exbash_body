#!/bin/bash
####################################################################################################
# ExBash - Bash-based shell with extra editing features
####################################################################################################

#---------------------------------------------------------------------------------------------------
# Step 0: Define constants and local functions.
#---------------------------------------------------------------------------------------------------

# Version info of ExBash.
exbash_version="2026.08.30"

# Help message of ExBash.
exbash_help_message="
ExBash is a Bash-based shell that allows you to use commands with the same syntax as Bash,
while providing a more powerful command input experience than Bash.

Usage:
    exbash [--clean] [--config PATH] [-h|--help] [-v|--version]

Clean options:
    --clean         Clean the cache files generated by ExBash.

Config options:
    --config PATH   Path to config file.

Other options:
    -h, --help      Show this message and exit.
    -v, --version   Show version info and exit.
"

# Select the first existing file from the given list of files, and return its path.
function select_existing_file ()
{   # {{{

    # Find the first existing file from the given list, print its path, and exit this function.
    for file in "${@}"; do
        if [ -f "${file}" ]; then
            echo "${file}"
            return 0
        fi
    done

    # Otherwise, print an error message and exit this function.
    echo "-"
    return 0

}   # }}}

# Bashrc file candidates to load.
bashrc_files=(
    "${HOME}/.config/exbash/bashrc"
    "${HOME}/.config/exbash/exbashrc"
    "${HOME}/.local/share/exbash/default/bashrc"
)

# Config file candidates to load.
config_files=(
    "${HOME}/.config/exbash/config.toml"
    "${HOME}/.local/share/exbash/default/config.toml"
)

# Select the bashrc and config files to load.
path_bashrc=$(select_existing_file "${bashrc_files[@]}")
path_config=$(select_existing_file "${config_files[@]}")

# Define temporary directory.
# NOTES: Use a temporary directory in RAM for temporary files that are frequently rewritten.
tmpdir_rom="/tmp/exbash"
tmpdir_ram="/dev/shm/exbash"

# Define the "exbash_readcmd" command path.
readcmd="${tmpdir_rom}/exbash_readcmd"

#---------------------------------------------------------------------------------------------------
# Step 1: Bash compatibility fallback.
#---------------------------------------------------------------------------------------------------

function find_real_bash ()
{   # {{{

    # Check if /bin/bash exists and is executable.
    local bash_path="/bin/bash"
    if [[ -x "$bash_path" ]]; then
        printf '%s\n' "$bash_path"
        return 0
    fi

    # Check other Bash paths in the system PATH.
    bash_path="$(command -v bash 2>/dev/null || true)"
    if [[ -n "$bash_path" && -x "$bash_path" ]]; then
        printf '%s\n' "$bash_path"
        return 0
    fi

    return 1

}   # }}}

# Find the real Bash executable path and store it in a variable.
exbash_real_bash="$(find_real_bash)" || {
    echo "exbash: real bash not found" >&2
    exit 127
}

# If the user specifies the "-c" option, execute the real Bash and exit.
for arg in "$@"; do
    case "$arg" in
        -c | -[!-]*c* )
            exec "${exbash_real_bash}" "$@"
            ;;
    esac
done

# If the standard input or output is not a terminal, execute the real Bash and exit.
if [[ ! -t 0 || ! -t 1 ]]; then
    exec "${exbash_real_bash}" "$@"
fi

#---------------------------------------------------------------------------------------------------
# Step 2: Confirm the existence of "exbash_readcmd".
#---------------------------------------------------------------------------------------------------

# Extract the binary part of this script and save it as "exbash_readcmd" in the temporary directory.
function extract_binary_and_save ()
{   # {{{

    my_self="${1}"
    readcmd="${2}"

    if [ ! -f "${readcmd}" ]; then

        # Find the starting line of the binary in this script.
        PAYLOAD_LINE=$(awk '/^__PAYLOAD_BELOW__/ {print NR + 1; exit 0;}' "${my_self}")

        # Extract binary.
        tail -n +"${PAYLOAD_LINE}" "${my_self}" > "${readcmd}"
        chmod +x "${readcmd}"

    fi

    if [ ! -f "${readcmd}" ]; then

        echo "ExBash: cannot find 'exbash_readcmd': something went wrong during the initialization process."
        echo ""
        echo "For more detailed installation instruction, please see:"
        echo "<https://github.com/tiskw/exbash/>"
        exit 1

    fi

}   # }}}

# Make temporary directories.
mkdir -p "${tmpdir_rom}"
mkdir -p "${tmpdir_ram}"

# Extract the binary part of this script and save it as "exbash_readcmd" in the temporary directory.
extract_binary_and_save "${0}" "${readcmd}"

#---------------------------------------------------------------------------------------------------
# Step 3: Process command line arguments.
#---------------------------------------------------------------------------------------------------

# Clean the cache files generated by ExBash.
function clean_caches ()
{   # {{{

    rm -fr "${tmpdir_rom}" "${tmpdir_ram}"
    echo "ExBash: Cache files cleaned successfully."
    exit 0

}   # }}}

# Print help message and exit.
function print_help ()
{   # {{{

    "${readcmd}" --run logo
    printf "%s" "${exbash_help_message}"
    exit 0

}   # }}}

# Print version info and exit.
function print_version ()
{   # {{{

    printf "%s\n" "${exbash_version}"
    exit 0

}   # }}}

# Parse command line arguments.
# This function is possible to update the config file path if specified by the user.
args=$(getopt -o c:hlv -l clean,config:,help,version -- "$@")
eval set -- "${args}"
while [[ ${#} -gt 0 ]]; do
    case "${1}" in
             --config ) path_config="${2}"; shift 2 ;;
             --clean  ) clean_caches; exit 0 ;;
        -h | --help   ) print_help; exit 0 ;;
        -v | --version) print_version; exit 0 ;;
        --) shift; break ;;
    esac
done

# Check the existence of the config file specified by the user.
if [[ ! -f "${path_config}" ]]; then
    path_config="-"
fi

#---------------------------------------------------------------------------------------------------
# Step 4: Load Bash config files.
#---------------------------------------------------------------------------------------------------

# Setup Bash environment.
shopt -s expand_aliases

# Load the bashrc file if it exists.
if [[ "${path_bashrc}" != "-" ]]; then
    source "${path_bashrc}"
fi

#---------------------------------------------------------------------------------------------------
# Step 5: Start the main loop.
#---------------------------------------------------------------------------------------------------

function get_bash_editor_mode ()
{   # {{{

    local mode_status
    mode_status=$(set -o)

    if echo "$mode_status" | grep '^emacs\s*on$'; then
        echo "emacs"
    elif echo "$mode_status" | grep -Eq '^vi\s*on$'; then
        echo "vi"
    else
        echo "emacs"
    fi

}   # }}}

function exbash_main_loop ()
{   # {{{

    readcmd="${1}"
    path_output="${2}"
    path_config="${3}"
    path_bash_info="${4}"

    # Create a command string to run "exbash_readcmd" with the output file and config file.
    cmd_readcmd="${readcmd} -o ${path_output}"
    if [[ -f "${path_config}" ]]; then
        cmd_readcmd="${cmd_readcmd} --config ${path_config}"
    fi

    # Run "exbash_readcmd" in the background to generate the cache of path commands.
    ${cmd_readcmd} --run generate_path_commands_cache &

    # Starts the main loop.
    while true; do

        # Update bash info.
        compgen -ab          > "${path_bash_info}"
        compgen -A function >> "${path_bash_info}"

        # Run the "exbash_readcmd" command, and show warning message if "exbash_readcmd" returns an error code.
        if ! ${cmd_readcmd} --editor "$(get_bash_editor_mode)"; then

            echo "ExBash: WARNING: Critical failure occurred in 'exbash_readcmd'."
            echo -n "Would you like to close ExBash? [y/N] "
            read -r input

            # Terminate if user response is YES.
            if [[ "${input,,}" == "y" ]]; then
                exit 1
            fi

        fi

        # Capture the output of "exbash_readcmd".
        user_command=$(< "${path_output}")

        # Exit if the user input is "exit" or "^D".
        if [ "${user_command}" = "exit" ] || [ "${user_command}" = "^D" ]; then
            echo "Bye!"
            break
        fi

        # Execute the user command.
        eval "${user_command}"
        echo ""

        # Append the user input to the history file.
        # If the user command starts with a whitespace, skip to append.
        if [[ "${user_command}" =~ ^[a-zA-Z\.].*$ ]]; then

            echo "${user_command}" >> ~/.bash_history

            # Strip the history file if the number of lines exceeds its limit.
            if [ $(cat "${HOME}/.bash_history" | wc -l) -gt "${HISTSIZE:-500}" ]; then
                uniq "${HOME}/.bash_history" | tail -n "${HISTSIZE}" > /tmp/bash_history
                mv -f /tmp/bash_history "${HOME}/.bash_history"
            fi

        fi

    done

}   # }}}

# Ignore Ctrl-C on this Bash script.
trap "echo 'exbash: SIGINT (Ctrl-C) detected'" SIGINT

# Update the command and bash info.
path_cmnd_info=$("${readcmd}" --config "${path_config}" --run "print_config=path_cmnd_info")
path_bash_info=$("${readcmd}" --config "${path_config}" --run "print_config=path_bash_info")

# Create an output file (named pipe).
path_output=$(mktemp -u "${tmpdir_ram}/readcmd_output.pipe.XXXXXX")

# ExBash itself is the interactive frontend. The child applications should use Bash for shell escapes.
export EXBASH_ACTIVE=1
export EXBASH_SHELL="$0"
export SHELL="${exbash_real_bash}"

# Start the main loop of ExBash.
exbash_main_loop "${readcmd}" "${path_output}" "${path_config}" "${path_bash_info}"

#---------------------------------------------------------------------------------------------------
# Step 6: Post processings.
#---------------------------------------------------------------------------------------------------

# Remove the output file.
rm -f "${path_output}"

# Exit with success code.
exit 0

#---------------------------------------------------------------------------------------------------
# Binary file container.
#---------------------------------------------------------------------------------------------------

__PAYLOAD_BELOW__
